{
  "name": "@igx-nexus/ui",
  "version": "0.1.0-dev",
  "private": true,
  "description": "Sistema de diseño compartido de IGX NEXUS",
  "type": "module",
  "scripts": {
    "build:tokens": "tsc -p tsconfig.tokens.json && node dist-tokens/scripts/build-tokens.js",
    "typecheck": "npm run typecheck:tokens && npm run typecheck:ui",
    "build": "npm run build:tokens && npm run build:ui",
    "typecheck:tokens": "tsc -p tsconfig.tokens.json --noEmit",
    "typecheck:ui": "tsc -p tsconfig.json --noEmit",
    "build:ui": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/browser-playwright": "^4.1.11",
    "playwright": "^1.63.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.6.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles/index.css"
  },
  "files": [
    "dist",
    "generated",
    "styles"
  ],
  "dependencies": {
    "lucide-react": "^1.42.0",
    "react-aria-components": "^1.21.1"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
