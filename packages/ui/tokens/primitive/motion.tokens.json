{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "duration": {
    "$type": "duration",
    "instant": {
      "$value": { "value": 0, "unit": "ms" }
    },
    "fast": {
      "$value": { "value": 120, "unit": "ms" }
    },
    "normal": {
      "$value": { "value": 200, "unit": "ms" }
    },
    "slow": {
      "$value": { "value": 320, "unit": "ms" }
    }
  },
  "cubicBezier": {
    "$type": "cubicBezier",
    "standard": {
      "$value": [0.2, 0, 0, 1]
    },
    "accelerate": {
      "$value": [0.4, 0, 1, 1]
    },
    "decelerate": {
      "$value": [0, 0, 0.2, 1]
    }
  }
}
