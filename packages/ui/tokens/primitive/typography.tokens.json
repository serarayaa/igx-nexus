{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "fontFamily": {
    "$type": "fontFamily",
    "sans": {
      "$value": [
        "system-ui",
        "Segoe UI",
        "Roboto",
        "Helvetica Neue",
        "Arial",
        "sans-serif"
      ]
    },
    "mono": {
      "$value": [
        "Cascadia Code",
        "SFMono-Regular",
        "Consolas",
        "Liberation Mono",
        "monospace"
      ]
    }
  },
  "fontWeight": {
    "$type": "fontWeight",
    "regular": {
      "$value": 400
    },
    "medium": {
      "$value": 500
    },
    "semibold": {
      "$value": 600
    },
    "bold": {
      "$value": 700
    }
  },
  "fontSize": {
    "$type": "dimension",
    "xs": {
      "$value": { "value": 12, "unit": "px" }
    },
    "sm": {
      "$value": { "value": 14, "unit": "px" }
    },
    "md": {
      "$value": { "value": 16, "unit": "px" }
    },
    "lg": {
      "$value": { "value": 18, "unit": "px" }
    },
    "xl": {
      "$value": { "value": 20, "unit": "px" }
    },
    "2xl": {
      "$value": { "value": 24, "unit": "px" }
    },
    "3xl": {
      "$value": { "value": 30, "unit": "px" }
    },
    "4xl": {
      "$value": { "value": 36, "unit": "px" }
    }
  },
  "lineHeight": {
    "$type": "number",
    "tight": {
      "$value": 1.2
    },
    "snug": {
      "$value": 1.35
    },
    "normal": {
      "$value": 1.5
    },
    "relaxed": {
      "$value": 1.65
    }
  }
}
