# IGX NEXUS local development environment
# Copy this file to .env and replace placeholder values locally.

NODE_ENV=development
NEXUS_APP_NAME=IGX NEXUS
NEXUS_APP_URL=http://localhost:3000
NEXUS_API_URL=http://localhost:4000

# GLPI
GLPI_BASE_URL=http://localhost:8080
GLPI_CLIENT_ID=change-me
GLPI_CLIENT_SECRET=change-me

# Database
DB_HOST=db
DB_PORT=3306
DB_NAME=igx_nexus
DB_USER=igx_nexus
DB_PASSWORD=change-me

# Redis
REDIS_URL=redis://redis:6379

# Never commit real credentials or production values.
