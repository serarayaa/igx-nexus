# Entorno local de desarrollo de IGX NEXUS
# Copia este archivo como .env y reemplaza localmente los valores de ejemplo.
# Nunca versiones .env ni credenciales reales.

NODE_ENV=development
TZ=America/Santiago

# Endpoints de NEXUS (servicios implementados en tickets posteriores)
NEXUS_APP_NAME=IGX NEXUS
NEXUS_APP_URL=http://localhost:3000
NEXUS_WEB_PORT=3000
NEXUS_API_URL=http://localhost:8000
NEXUS_API_PORT=8000

# GLPI local / Docker
GLPI_IMAGE=glpi/glpi:11.0.8
GLPI_HTTP_PORT=8080
GLPI_BASE_URL=http://localhost:8080
GLPI_DB_HOST=mariadb
GLPI_DB_PORT=3306
GLPI_DB_NAME=glpi
GLPI_DB_USER=glpi
GLPI_DB_PASSWORD=change-me-with-a-random-local-password

# NEXUS API -> GLPI Live (V02-006)
# Mantener comentado mientras se use Demo. Para un Live Lab autorizado, copiar .env
# localmente, descomentar y reemplazar los placeholders sin versionar el archivo.
# NEXUS_PROVIDER_MODE=live
# NEXUS_GLPI_BASE_URL=https://glpi.example/
# NEXUS_GLPI_OAUTH_CLIENT_ID=replace-with-client-id
# NEXUS_GLPI_SERVICE_USERNAME=svc-nexus-api
# NEXUS_GLPI_OAUTH_CLIENT_SECRET=replace-locally-with-client-secret
# NEXUS_GLPI_SERVICE_PASSWORD=replace-locally-with-service-password
# NEXUS_GLPI_REQUEST_TIMEOUT_MS=10000
# NEXUS_GLPI_TOKEN_REFRESH_SKEW_SECONDS=60
# NEXUS_GLPI_PAGE_SIZE=100
# NEXUS_GLPI_MAX_RECORDS=10000
# NEXUS_GLPI_ALLOW_INSECURE_HTTP=false

# MariaDB
MARIADB_IMAGE=mariadb:11.4
MARIADB_ROOT_PASSWORD=change-me-with-another-random-local-password

# Redis
REDIS_IMAGE=redis:7.4-alpine
REDIS_URL=redis://redis:6379
