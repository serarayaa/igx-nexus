# IGX NEXUS local development environment
# Copy this file to .env and replace placeholder values locally.
# Never commit .env or real credentials.

NODE_ENV=development
TZ=America/Santiago

# NEXUS endpoints (services implemented in later tickets)
NEXUS_APP_NAME=IGX NEXUS
NEXUS_APP_URL=http://localhost:3000
NEXUS_WEB_PORT=3000
NEXUS_API_URL=http://localhost:8000
NEXUS_API_PORT=8000

# GLPI
GLPI_IMAGE=glpi/glpi:11.0.8
GLPI_HTTP_PORT=8080
GLPI_BASE_URL=http://localhost:8080
GLPI_DB_HOST=mariadb
GLPI_DB_PORT=3306
GLPI_DB_NAME=glpi
GLPI_DB_USER=glpi
GLPI_DB_PASSWORD=change-me-with-a-random-local-password

# MariaDB
MARIADB_IMAGE=mariadb:11.4
MARIADB_ROOT_PASSWORD=change-me-with-another-random-local-password

# Redis
REDIS_IMAGE=redis:7.4-alpine
REDIS_URL=redis://redis:6379
